---
/**
 * Small line-drawn icons for social links, drawn here as simple outlines (no third-party
 * icon set, no external request). They take the surrounding text colour (currentColor)
 * and are decorative: the link's visible text names it.
 */
interface Props {
  name: 'linkedin' | 'instagram';
}
const { name } = Astro.props;
---

<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === 'instagram' ? (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.75" />
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75" />
        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
      </>
    ) : (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.75" />
        <circle cx="8" cy="7.9" r="1.15" fill="currentColor" />
        <rect x="7" y="10.3" width="2" height="6.7" fill="currentColor" />
        <path
          fill="currentColor"
          d="M11 17v-6.7h1.95v.95c.5-.72 1.36-1.13 2.37-1.13 1.78 0 2.68 1.15 2.68 3.05V17h-2v-3.5c0-.98-.42-1.52-1.26-1.52-.92 0-1.74.62-1.74 1.78V17z"
        />
      </>
    )
  }
</svg>

<style>
  .social-icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }
</style>
