---
import Wordmark from './Wordmark.astro';
import { POLICY_AREAS } from '../config/taxonomy';

/**
 * Main navigation. An item with `children` becomes a dropdown (a disclosure menu: a
 * button that shows or hides a list of links). To add a page to a dropdown, add an
 * entry to its `children`; to add another dropdown, give any item `children`.
 * "Home" is always first, so it sits in the leftmost slot of the nav.
 */
interface NavLink {
  href: string;
  label: string;
}
interface NavMenu {
  label: string;
  /** URL prefix that makes this menu the current section (e.g. "/research/"). */
  section: string;
  children: NavLink[];
}
type NavItem = NavLink | NavMenu;

const nav: NavItem[] = [
  { href: '/', label: 'Home' },
  {
    label: 'Research',
    section: '/research/',
    children: [
      { href: '/research/', label: 'Our Work' },
      { href: '/research/washington-library-gap-map/', label: 'Washington Library Gap Map' },
    ],
  },
  {
    // One link per policy area, straight to its page (from the taxonomy, so it stays in sync).
    label: 'Policy Areas',
    section: '/areas/',
    children: POLICY_AREAS.map((area) => ({ href: `/areas/${area.id}/`, label: area.name })),
  },
  { href: '/team/', label: 'Team' },
  { href: '/about/', label: 'About' },
  { href: '/join/', label: 'Join' },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// Home only matches "/" exactly (every path starts with "/"); others match their whole section.
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
/*
 * Inside a menu, the most specific matching link is current: the Gap Map link on the
 * tool's page, "Our Work" on /research/ and on individual paper pages.
 */
const currentChild = (menu: NavMenu) =>
  menu.children
    .filter((c) => isCurrent(c.href))
    .sort((a, b) => b.href.length - a.href.length)[0]?.href;
const isMenu = (item: NavItem): item is NavMenu => 'children' in item;
---

<header class="site-header">
  <div class="container site-header__inner">
    <Wordmark />
    <nav aria-label="Main">
      <ul class="site-nav">
        {
          nav.map((item, i) =>
            isMenu(item) ? (
              <li class="nav-menu" data-nav-menu>
                <button
                  type="button"
                  class="nav-menu__button"
                  aria-expanded="false"
                  aria-controls={`nav-menu-${i}`}
                  aria-current={isCurrent(item.section) ? 'true' : undefined}
                >
                  {item.label}
                  <svg class="nav-menu__chevron" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                </button>
                <ul class="nav-menu__list" id={`nav-menu-${i}`}>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={currentChild(item) === child.href ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/nav-menu.ts';
</script>

<style>
  /* Masthead: serif wordmark left, nav right, a solid plum rule beneath. */
  /*
   * Sticky: the header stays at the top of the screen while the page scrolls. Its solid
   * background keeps the page from showing through. z-index keeps it (and its dropdowns)
   * above the content scrolling underneath.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 3;
    border-bottom: var(--hairline) solid var(--color-rule);
    background: var(--color-bg);
  }
  /*
   * Home page: the header lies on top of the full-screen photo's upper edge (it keeps
   * its solid background), so the photo fills the rest of the screen exactly. Fixed, not
   * sticky, so it takes no room in the layout and still stays put while scrolling.
   */
  :global(body:has(.hero--cover)) .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }
  /* Full page width: the logo sits near the top-left corner, the nav near the right edge. */
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    max-width: none;
    padding-block: var(--space-4);
    padding-inline: var(--header-inset);
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a,
  .nav-menu__button {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-block;
    padding-block: var(--space-1);
  }
  .site-nav a:hover {
    color: var(--color-text);
    text-decoration-line: underline;
  }
  /* Current page (or section): plum (darker than the other links) with the thick pink mark. */
  .site-nav a[aria-current='page'],
  .nav-menu__button[aria-current='true'] {
    color: var(--color-text);
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-hover-mark);
    text-decoration-thickness: var(--underline-current);
    text-underline-offset: 0.06em;
    text-decoration-skip-ink: none;
  }

  /* ---- Dropdown (disclosure menu) ---- */
  .nav-menu {
    position: relative;
  }
  .nav-menu__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: 0;
    padding-inline: 0;
    cursor: pointer;
  }
  .nav-menu__button:hover {
    color: var(--color-text);
  }
  .nav-menu__chevron {
    width: 0.7em;
    height: 0.45em;
    transition: transform var(--transition-fast);
  }
  .nav-menu[data-open] .nav-menu__chevron {
    transform: rotate(180deg);
  }
  /* The panel: a quiet list under a plum rule, no shadow. */
  .nav-menu__list {
    display: none;
    position: absolute;
    top: 100%;
    left: calc(-1 * var(--space-4));
    min-width: 16rem;
    max-width: calc(100vw - 2 * var(--gutter));
    margin: var(--space-2) 0 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--color-bg);
    border: var(--hairline) solid var(--color-hairline);
    border-top: var(--hairline) solid var(--color-rule);
  }
  .nav-menu__list a {
    display: block;
    padding: var(--space-2) var(--space-4);
    white-space: normal;
  }
  /* Script running: the script controls opening (hover, click/tap, focus, Escape). */
  .nav-menu[data-open] .nav-menu__list {
    display: block;
  }
  /* No script: hovering or focusing inside the menu still shows it. */
  :global(:root:not(.js-nav)) .nav-menu:hover .nav-menu__list,
  :global(:root:not(.js-nav)) .nav-menu:focus-within .nav-menu__list {
    display: block;
  }

  /*
   * Tablets (768–1023px): slightly tighter gaps and side padding, so the wordmark and nav
   * still fit on one row at the 95% site scale. Wider screens keep the roomier spacing.
   */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .site-header__inner {
      column-gap: var(--space-5);
      padding-inline: var(--space-4);
    }
    .site-nav {
      column-gap: var(--space-4);
    }
  }

  /* Phones: the nav sits under the wordmark as a single quiet row. */
  @media (max-width: 40rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding-block: var(--space-4) var(--space-3);
    }
    .site-nav {
      gap: 0 var(--space-4);
    }
    .nav-menu__list {
      left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-menu__chevron {
      transition: none;
    }
  }
</style>
