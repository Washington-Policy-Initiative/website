---
/** A publication's policy areas as small labels, each in its area's colour (see tokens.css). */
import { POLICY_AREAS, labelFor } from '../config/taxonomy';
import type { Publication } from '../lib/content';

interface Props {
  pub: Publication;
}
const { areas } = Astro.props.pub.data;
---

<ul class="area-tags" aria-label="Policy areas">
  {areas.map((area) => <li class:list={['area-tag', `area-tag--${area}`]}>{labelFor(POLICY_AREAS, area)}</li>)}
</ul>

<style>
  .area-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .area-tag {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-ui);
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
  }
  .area-tag--economic {
    background: var(--color-area-economic-bg);
    color: var(--color-area-economic-text);
  }
  .area-tag--education {
    background: var(--color-area-education-bg);
    color: var(--color-area-education-text);
  }
  .area-tag--environmental {
    background: var(--color-area-environmental-bg);
    color: var(--color-area-environmental-text);
  }
  .area-tag--civic {
    background: var(--color-area-civic-bg);
    color: var(--color-area-civic-text);
  }
</style>
