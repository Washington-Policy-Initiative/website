---
/** Clean empty state used wherever a list has nothing in it yet. */
interface Props {
  title?: string;
}
const { title = 'Announced soon' } = Astro.props;
---

<div class="notice">
  <p class="coming-soon__title">{title}</p>
  <slot />
</div>

<style>
  .coming-soon__title {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .coming-soon__title:last-child {
    margin-bottom: 0;
  }
</style>
