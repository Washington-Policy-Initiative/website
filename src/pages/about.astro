---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import { facultyLabel, getCurrentPeople } from '../lib/content';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(page);

const faculty = (await getCurrentPeople()).filter((p) => p.data.role === 'faculty');
const facultyText = facultyLabel(faculty.length);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader title={page.data.title} />
  <div class="container about">
    <div class="rich-text prose">
      <Content />
    </div>

    <section class="advisors" aria-labelledby="advisors-heading">
      <h2 id="advisors-heading" class="section-heading">{facultyText.heading}</h2>
      <p class="prose muted text-center">
        {
          faculty.length === 1
            ? 'Our faculty advisor guides our research and reviews our work.'
            : 'Our faculty advisors guide our research and review our work.'
        }{' '}
        We're working to bring more faculty on board.
      </p>
      <PeopleGrid people={faculty} showArea={false} />
    </section>

    <p class="about__links text-center">
      <a href="/team/">Meet the full team →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .about {
    padding-bottom: var(--space-7);
  }
  .advisors {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: var(--hairline) solid var(--color-hairline);
  }
  .advisors > p {
    font-style: italic;
    margin-bottom: var(--space-7);
  }
  .about__links {
    margin-top: var(--space-7);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
</style>
