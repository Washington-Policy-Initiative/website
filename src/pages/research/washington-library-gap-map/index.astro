---
/**
 * Washington Library Gap Map (data tool). A WPI rebuild of Liam Peterson's
 * WA School Library Report Card: see reference/library-tool-analysis.md.
 *
 * Everything readable (overview, key figures, the full district table, About the data)
 * is rendered here at build time. src/scripts/gapmap.ts (loaded on this page only, with
 * D3 bundled from npm) adds the map, district report, locale chart, and table sorting.
 * It loads two JSON files served next to this page: data.json and districts.json.
 * No third-party requests, no inline scripts or styles: the site-wide CSP is unchanged.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaTags from '../../../components/AreaTags.astro';
import GapMapOverview from '../../../components/gapmap/GapMapOverview.astro';
import DistrictMap from '../../../components/gapmap/DistrictMap.astro';
import DistrictReport from '../../../components/gapmap/DistrictReport.astro';
import LocaleChart from '../../../components/gapmap/LocaleChart.astro';
import DistrictTable from '../../../components/gapmap/DistrictTable.astro';
import AboutTheData from '../../../components/gapmap/AboutTheData.astro';
import { getEntry } from 'astro:content';
import { KEY_FIGURES } from '../../../lib/gapmap';

const TITLE = 'Washington Library Gap Map';
const SUBTITLE = 'Librarian staffing in 298 districts, 2015–2025';

/*
 * PLACEHOLDER: the accompanying research paper. Once it's published, set this to
 * { title: '…', href: '/research/<paper-id>/' } and a link appears under the byline.
 */
const ACCOMPANYING_PAPER = null as { title: string; href: string } | null;

const entry = await getEntry('publications', 'washington-library-gap-map');
if (!entry) throw new Error('Missing src/content/publications/washington-library-gap-map.md');

const k = KEY_FIGURES;
const fmt1 = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fmt0 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 0 });
---

<BaseLayout
  title={TITLE}
  description={`${SUBTITLE}. An interactive map and table of school librarian staffing in every Washington school district, from OSPI data.`}
>
  <article class="container gm-page" data-gapmap>
    <header class="gm-head">
      <p class="eyebrow">
        <a href="/research/">Research</a> / Data Tool
      </p>
      <h1 class="gm-head__title">{TITLE}</h1>
      <p class="gm-head__subtitle">{SUBTITLE}</p>
      <p class="gm-head__byline">
        By <a href="/team/liam-peterson/">Liam Peterson</a>
      </p>
      {
        ACCOMPANYING_PAPER && (
          <p class="gm-head__paper">
            Accompanying paper: <a href={ACCOMPANYING_PAPER.href}>{ACCOMPANYING_PAPER.title}</a>
          </p>
        )
      }
      <AreaTags pub={entry} />
    </header>

    <GapMapOverview />

    <section class="gm-figures-row" aria-label="Key figures, 2024–25">
      <dl class="gm-key">
        <div>
          <dt>Districts reporting no librarian</dt>
          <dd>{k.zeroLatest} <span class="gm-key__of">of {k.count}</span></dd>
          <dd class="gm-key__sub">{k.zeroPctLatest}% of districts, 2024–25</dd>
        </div>
        <div>
          <dt>Librarian FTE statewide</dt>
          <dd>{fmt1(k.fteLatest)}</dd>
          <dd class="gm-key__sub">full-time-equivalent positions, 2024–25</dd>
        </div>
        <div>
          <dt>Change since 2015–16</dt>
          <dd>−{fmt0(Math.abs(k.fteChangePct))}%</dd>
          <dd class="gm-key__sub">from {fmt1(k.fteFirst)} FTE in 2015–16</dd>
        </div>
        <div>
          <dt>Students per librarian</dt>
          <dd>{fmt0(k.medianStudentsPerLibrarian)}</dd>
          <dd class="gm-key__sub">median of the {k.districtsWithLibrarian} districts with a librarian</dd>
        </div>
      </dl>
    </section>

    <DistrictMap />
    <DistrictReport />
    <LocaleChart />
    <DistrictTable />
    <AboutTheData />
  </article>
</BaseLayout>

<script>
  import '../../../scripts/gapmap.ts';
</script>

<style>
  .gm-page {
    padding-block: var(--space-8) var(--space-7);
  }

  /* ---- Title block ---- */
  .gm-head {
    max-width: var(--wide-width);
    margin-bottom: var(--space-7);
  }
  .gm-head__title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }
  .gm-head__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .gm-head__byline,
  .gm-head__paper {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  /* ---- Key figures ---- */
  .gm-figures-row {
    margin: var(--space-8) 0 0;
  }
  .gm-key {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-5) var(--space-6);
    margin: 0;
  }
  .gm-key div {
    display: flex;
    flex-direction: column;
    border-top: var(--hairline) solid var(--color-rule);
    padding-top: var(--space-3);
  }
  .gm-key dt {
    order: 2;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
  }
  .gm-key dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    font-variant-numeric: lining-nums tabular-nums;
    order: 1;
  }
  .gm-key__of {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .gm-key dd.gm-key__sub {
    order: 3;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  /* ---- Shared by the gap map's sections (child components, hence :global) ---- */
  .gm-page :global(.gm-section) {
    margin-top: var(--space-9);
  }
  .gm-page :global(.gm-section__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    border-bottom: var(--hairline) solid var(--color-rule);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .gm-page :global(.gm-section__title) {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
    margin: 0;
  }
  .gm-page :global(.gm-section__intro) {
    max-width: var(--prose-width);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
  }

  /* Charts */
  .gm-page :global(.gm-chart) {
    margin: 0;
  }
  .gm-page :global(.gm-chart__caption) {
    max-width: var(--prose-width);
    margin-bottom: var(--space-3);
  }
  .gm-page :global(.gm-chart__summary) {
    display: block;
    font-size: var(--text-base);
  }
  .gm-page :global(.gm-chart__plot svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .gm-page :global(.gm-chart text) {
    font-family: var(--font-ui);
    font-size: 12px;
    fill: var(--color-text-muted);
  }
  .gm-page :global(.gm-chart .gm-tick-narrow) {
    font-size: 10.5px;
  }
  .gm-page :global(.gm-chart .gm-bar-value) {
    font-size: 13px;
    font-weight: var(--weight-semibold);
    fill: var(--color-text);
  }
  .gm-page :global(.gm-chart .gm-axis path),
  .gm-page :global(.gm-chart .gm-axis line) {
    stroke: var(--color-chart-grid);
  }
  .gm-page :global(.gm-chart .gm-grid line) {
    stroke: var(--color-chart-grid);
    stroke-dasharray: 2 3;
  }
  .gm-page :global(.gm-chart .gm-grid path) {
    display: none;
  }
  .gm-page :global(.gm-bar) {
    fill: var(--color-chart-bar);
  }
  .gm-page :global(.gm-line) {
    fill: none;
    stroke-width: 2;
  }
  .gm-page :global(.gm-line--district) {
    stroke: var(--color-chart-district);
    stroke-width: 3;
  }
  .gm-page :global(.gm-line--group) {
    stroke: var(--color-chart-group);
    stroke-dasharray: 7 4;
  }
  .gm-page :global(.gm-line--state) {
    stroke: var(--color-chart-state);
    stroke-dasharray: 2 3;
  }
  .gm-page :global(.gm-dot) {
    fill: var(--color-chart-district);
  }
  .gm-page :global(.gm-line-label) {
    font-weight: var(--weight-semibold);
  }
  .gm-page :global(.gm-line-label--district) {
    fill: var(--color-chart-district);
  }

  /* District report chart: hover/tap a year to compare the three values (user request). */
  .gm-page :global(.gm-chart__frame) {
    position: relative;
  }
  .gm-page :global(.gm-chart__plot svg) {
    touch-action: pan-y; /* a horizontal drag moves through the years; vertical still scrolls */
  }
  .gm-page :global(.gm-focus__catch) {
    fill: transparent;
    cursor: crosshair;
  }
  .gm-page :global(.gm-focus__guide) {
    stroke: var(--color-text-muted);
    stroke-width: 1;
  }
  .gm-page :global(.gm-focus__dot) {
    stroke: var(--color-bg);
    stroke-width: 2;
  }
  .gm-page :global(.gm-focus__dot--district) {
    fill: var(--color-chart-district);
  }
  .gm-page :global(.gm-focus__dot--group) {
    fill: var(--color-chart-group);
  }
  .gm-page :global(.gm-focus__dot--state) {
    fill: var(--color-chart-state);
  }
  .gm-page :global(.gm-chart__tooltip) {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    min-width: 13rem;
    max-width: 17rem;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: var(--hairline) solid var(--color-rule);
    box-shadow: var(--card-shadow);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    line-height: var(--leading-ui);
  }
  .gm-page :global(.gm-chart__tooltip strong) {
    display: block;
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }
  .gm-page :global(.gm-chart__tooltip dl) {
    margin: 0;
  }
  .gm-page :global(.gm-chart__tooltip dl > div) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .gm-page :global(.gm-chart__tooltip dt) {
    color: var(--color-text-muted);
  }
  .gm-page :global(.gm-chart__tooltip dd) {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-semibold);
  }
  /* Small line samples matching each line's style, so the key doesn't rely on colour alone. */
  .gm-page :global(.gm-tip-key) {
    display: inline-block;
    width: 1.1rem;
    margin-right: var(--space-2);
    vertical-align: middle;
    border-top: 2px solid var(--color-chart-district);
  }
  .gm-page :global(.gm-tip-key--district) {
    border-top-width: 3px;
  }
  .gm-page :global(.gm-tip-key--group) {
    border-top: 2px dashed var(--color-chart-group);
  }
  .gm-page :global(.gm-tip-key--state) {
    border-top: 2px dotted var(--color-chart-state);
  }

  /* "View as table" disclosures and data tables */
  .gm-page :global(.gm-data-table) {
    margin-top: var(--space-3);
  }
  .gm-page :global(.gm-data-table summary) {
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: var(--underline-rest);
    text-underline-offset: 0.2em;
    width: fit-content;
  }
  .gm-page :global(.gm-data-table summary:hover) {
    text-decoration-color: var(--color-link-hover-mark);
    text-decoration-thickness: var(--underline-hover);
  }
  .gm-page :global(.gm-data-table[open] summary) {
    margin-bottom: var(--space-3);
  }
  .gm-page :global(.gm-table-scroll) {
    overflow-x: auto;
  }
  .gm-page :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .gm-page :global(th),
  .gm-page :global(td) {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--hairline) solid var(--color-hairline);
  }
  .gm-page :global(thead th) {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    border-bottom: var(--hairline) solid var(--color-rule);
  }
  .gm-page :global(.is-numeric),
  .gm-page :global(.gm-reading td),
  .gm-page :global(.gm-reading thead th) {
    text-align: right;
  }
</style>
