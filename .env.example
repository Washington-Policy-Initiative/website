# Names only. Never put real values in this file or anywhere in the repo.
# Real values go in Cloudflare Pages → Settings → Environment variables
# (mark GITHUB_OAUTH_CLIENT_SECRET as "Encrypted"/secret).

# GitHub OAuth App used by Decap CMS login (functions/api/auth.js, callback.js)
GITHUB_OAUTH_CLIENT_ID=
