# Security headers for Cloudflare Pages. Rules are matched top to bottom and combined;
# a line starting with "! " removes a header set by an earlier rule.
# Note: these apply only on Cloudflare. `astro dev` / `astro preview` ignore this file.

/*
  # CSP: start from "nothing allowed" (default-src 'none') and allow only our own origin
  # for each resource type the site actually uses. No 'unsafe-inline' and no 'unsafe-eval',
  # so even if someone slipped HTML into content, an injected <script> wouldn't run.
  #   base-uri 'none'        → an injected <base> tag can't redirect relative URLs
  #   form-action 'none'     → the site has no forms, so no page may submit one anywhere
  #   frame-ancestors 'none' → nobody can embed our pages in an iframe (clickjacking)
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  # Browsers must use HTTPS for a year. (No "preload" until we own the custom domain.)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Don't guess content types; a file served as text can't be run as a script.
  X-Content-Type-Options: nosniff
  # Older-browser equivalent of frame-ancestors 'none'.
  X-Frame-Options: DENY
  # Send only our origin (not full URLs) to other sites when visitors follow links.
  Referrer-Policy: strict-origin-when-cross-origin
  # Turn off powerful browser features the site never uses.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  # Isolate our browsing context from cross-origin windows we open or that open us.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hashed build assets never change, so browsers can cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The CMS admin needs a looser policy than the public site, scoped to /admin/ only:
#   style-src 'unsafe-inline' → Decap's UI injects its styles at runtime (CSS-in-JS)
#   img-src data: blob:       → image previews of files being uploaded
#   avatars.githubusercontent.com → the logged-in editor's GitHub avatar
#   connect-src api.github.com → Decap reads and writes content through the GitHub API
#   frame-src 'self' blob:   → the live preview pane
# Scripts are still 'self' only: Decap is self-hosted from /admin/decap/.
/admin/*
  ! Content-Security-Policy
  ! Cross-Origin-Opener-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://api.github.com; frame-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  # The login popup must be able to message this window (postMessage), so COOP is relaxed here.
  Cross-Origin-Opener-Policy: unsafe-none
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
